{
	# prod and staging ingress terminates TLS. set AUTO_HTTPS=on and SITE_ADDRESS
	# to a domain to let daddy(a.k.a caddy) manage certificates itself (single host only)
	auto_https {$AUTO_HTTPS:off}
	# no admin API: nothing needs it and it would be one more open port
	admin off
	servers {
		trusted_proxies static private_ranges
	}
	log {
		output stdout
		format json
	}
}

{$SITE_ADDRESS::8080} {
	encode zstd gzip

	# liveness/readiness probes. doesnt depend on the API.
	handle /healthz {
		respond "ok" 200
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	@backend path /api /api/* /auth /auth/*
	handle @backend {
		reverse_proxy {$API_UPSTREAM:127.0.0.1:3100} {
			# ride out the API's rolling updates instead of returning 502
			lb_try_duration 5s
			lb_try_interval 250ms
			fail_duration 10s
			transport http {
				dial_timeout 3s
			}
		}
	}

	handle /assets/* {
		root * {$WEB_ROOT:dist}
		header >Cache-Control "public, max-age=31536000, immutable" {
			match status 2xx
		}
		file_server
	}

	handle {
		root * {$WEB_ROOT:dist}
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
